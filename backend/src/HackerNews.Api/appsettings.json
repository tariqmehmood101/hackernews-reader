{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MediatR": {
    "LicenseKey": ""
  },
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/"
  },
  "Cache": {
    "RefreshIntervalSeconds": 300,
    "RetryIntervalSeconds": 30,
    "InitialLoadTimeoutSeconds": 10,
    "MaxConcurrentItemFetches": 15,
    "FullRefreshEveryNCycles": 12,
    "MinimumYieldPercent": 50
  },
  "RateLimiting": {
    "PermitLimitPerMinute": 100
  },
  "Network": {
    "TrustForwardedHeaders": false,
    "TrustedProxyHops": 1
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
